{
  "name": "gm-print-marketing-studio",
  "private": true,
  "version": "2.0.0-d3",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx --env-file=.env api/server.ts",
    "worker": "tsx --env-file=.env api/worker.ts",
    "migrate": "tsx --env-file=.env api/setup.ts migrate",
    "seed": "tsx --env-file=.env api/setup.ts seed",
    "build": "node build.mjs && node scripts/public-build.mjs",
    "typecheck": "tsc --noEmit",
    "test:demo": "node qc.mjs",
    "test": "tsx --env-file=.env --test tests/foundation.test.ts",
    "demo": "node server.mjs"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "connect-pg-simple": "10.0.0",
    "csv-parse": "7.0.3",
    "exceljs": "4.4.0",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "express-session": "1.19.0",
    "helmet": "8.3.0",
    "multer": "2.4.0",
    "pg": "8.23.0",
    "yauzl": "3.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/connect-pg-simple": "7.0.3",
    "@types/express": "5.0.6",
    "@types/express-session": "1.19.0",
    "@types/multer": "2.2.0",
    "@types/node": "26.6.3",
    "@types/pg": "8.23.1",
    "@types/yauzl": "3.4.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
